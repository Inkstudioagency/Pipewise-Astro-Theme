---
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = `/projects/${project.slug}`;
---

<div class="project-item-wrap"><img src={project.image.url} loading="lazy" class="project-image" alt={project.image.alt} srcset={project.image.srcset ?? undefined} sizes={project.image.srcset ? '(max-width: 767px) 100vw, (max-width: 991px) 95vw, 939px' : undefined}>
  <div class="project-info-wrap">
    <div class="project-badge">
      <div>Case Study</div>
    </div>
    <div class="project-info-block">
      <div class="project-summary-wrap">
        <a href={href} class="project-title-link v2 w-inline-block">
          <div>{project.name}</div>
          <div class="demo">#</div>
        </a>
        <p class="font-regular white-80">{project.shortDescription}</p>
      </div>
      <a href={href} class="blog-button white w-inline-block">
        <div class="blog-button-item home-hero">
          <div>View Case Study</div>
          <div class="button-arrow-wrap"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 18 18" fill="none" class="button-arrow">
              <path d="M10.5 3.69727L9.375 4.82227L12.8027 8.25H2.25V9.75H12.8027L9.375 13.1777L10.5 14.3027L15.8027 9L10.5 3.69727Z" fill="currentColor"></path>
            </svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 18 18" fill="none" class="button-arrow">
              <path d="M10.5 3.69727L9.375 4.82227L12.8027 8.25H2.25V9.75H12.8027L9.375 13.1777L10.5 14.3027L15.8027 9L10.5 3.69727Z" fill="currentColor"></path>
            </svg></div>
        </div>
        <div class="button-animated-line white"></div>
      </a>
    </div>
  </div>
</div>
