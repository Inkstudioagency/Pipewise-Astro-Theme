---
import type { Blog } from '@/lib/content';

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;
const href = `/blogs/${blog.slug}`;
---

<div to-top-0="" class="blog-featured-card side">
  <a href={href} class="blog-featured-image-wrap side w-inline-block"><img src={blog.image.url} loading="lazy" parallax="" class="blog-featured-image" alt={blog.image.alt} srcset={blog.image.srcset ?? undefined} sizes={blog.image.srcset ? '100vw' : undefined}>
    <div class="demo">#</div>
  </a>
  <div class="blog-featured-content side">
    <div class="blog-featured-top page">
      <div class="blog-card-meta">
        <p class="blog-date">{blog.category}</p>
        <p class="blog-date">•</p>
        <p class="blog-date">{blog.readTime}</p>
      </div>
      <div class="blog-card-title">{blog.title}</div>
    </div>
    <a href={href} class="blog-button w-inline-block">
      <div class="blog-button-item">
        <div>Read Article</div>
        <div class="button-arrow-wrap"><svg width="100%" fill="none" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" class="button-arrow">
            <path d="M10.5 3.69727L9.375 4.82227L12.8027 8.25H2.25V9.75H12.8027L9.375 13.1777L10.5 14.3027L15.8027 9L10.5 3.69727Z" fill="currentColor"></path>
          </svg><svg width="100%" fill="none" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" class="button-arrow">
            <path d="M10.5 3.69727L9.375 4.82227L12.8027 8.25H2.25V9.75H12.8027L9.375 13.1777L10.5 14.3027L15.8027 9L10.5 3.69727Z" fill="currentColor"></path>
          </svg></div>
      </div>
      <div class="button-animated-line"></div>
    </a>
  </div>
</div>
