---
import type { Blog } from '@/lib/content';

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;
const href = `/blogs/${blog.slug}`;
---

<div to-top-0="" class="blog-card v3">
  <a href={href} class="blog-card-media-v3 w-inline-block"><img src={blog.image.url} parallax="" class="blog-card-image v3" alt={blog.image.alt} srcset={blog.image.srcset ?? undefined} sizes={blog.image.srcset ? '(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px' : undefined}>
    <div class="demo">#</div>
  </a>
  <div class="blog-card-body-v3">
    <div class="blog-card-top v3">
      <div class="blog-card-title v3">{blog.title}</div>
    </div>
    <div class="blog-card-foot-v3">
      <a href={href} class="blog-button w-inline-block">
        <div class="blog-button-item">
          <div>Read Article</div>
          <div class="button-arrow-wrap"><svg fill="none" viewBox="0 0 18 18" width="100%" xmlns="http://www.w3.org/2000/svg" class="button-arrow">
              <path fill="currentColor" d="M10.5 3.69727L9.375 4.82227L12.8027 8.25H2.25V9.75H12.8027L9.375 13.1777L10.5 14.3027L15.8027 9L10.5 3.69727Z"></path>
            </svg><svg fill="none" viewBox="0 0 18 18" width="100%" xmlns="http://www.w3.org/2000/svg" class="button-arrow">
              <path fill="currentColor" d="M10.5 3.69727L9.375 4.82227L12.8027 8.25H2.25V9.75H12.8027L9.375 13.1777L10.5 14.3027L15.8027 9L10.5 3.69727Z"></path>
            </svg></div>
        </div>
        <div class="button-animated-line"></div>
      </a>
    </div>
  </div>
</div>
