---
import type { Service } from '@/lib/content';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<section class="section white-100">
  <div class="section-gap">
    <div class="container">
      <div class="promise-grid">
        <div to-top-0="" class="promise-media"><img src={service.promiseImage.url} parallax="" alt={service.promiseImage.alt} srcset={service.promiseImage.srcset ?? undefined} class="home-hero-image-v2"></div>
        <div class="promise-right">
          <div to-top-2="" class="promise-card">
            <div class="promise-head">
              <div class="section-badge">
                <div>Satisfaction Guaranteed</div>
              </div>
              <div class="service-details w-richtext">
                <h3>{service.promiseTitle}</h3>
                <p>{service.promiseText}</p>
              </div>
            </div>
            <a href="/contact-v1" data-wf--primary-btn--variant="base" data-wf-component-id="28b9e61e-764f-3ea9-2ebf-6915a5c8abb2" data-wf-variant-state="base" class="primary-button w-inline-block">
              <div class="button-text-wrapper">
                <div class="footer-link-text is-one">Book This Service</div>
                <div class="footer-link-text is-two">Book This Service</div>
              </div>
            </a>
          </div>
          <div class="promise-list-wrap">
            {service.promisePoints.map((point) => (
              <div to-top-0="" class="promise-row">
                <div class="promise-row-left"><svg fill="none" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" class="promise-row-icon">
                    <circle stroke-width="1.2" stroke="currentColor" r="6.6" cy="8" cx="8"></circle>
                    <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.2" stroke="currentColor" d="M5.4 8.15L7.15 9.9L10.6 6.45"></path>
                  </svg>
                  <div class="font-medium">{point}</div>
                </div><svg fill="none" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg" class="promise-row-arrow">
                  <path stroke-linejoin="round" stroke-linecap="round" stroke-width="1.2" stroke="currentColor" d="M3.5 10.5L10.5 3.5M10.5 3.5H5.25M10.5 3.5V8.75"></path>
                </svg>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
