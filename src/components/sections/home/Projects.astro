---
import DynList from '@/components/cms/DynList.astro';
import ProjectSlideCard from '@/components/cards/ProjectSlideCard.astro';
import { getProjects } from '@/lib/content';
const projects = await getProjects();
---

<section class="section project">
        <div data-delay="4000" data-animation="cross" class="project-slider w-slider" data-autoplay="false" to-top-0="" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
          <div class="project-slider-mask w-slider-mask">
            <div class="proejct-slider w-slide">
              <DynList items={projects.slice(0, 1)} class="project-collection-wrapper" itemsClass="project-collection-list" itemClass="project-collection-item-v1">{(project: any) => <ProjectSlideCard project={project} />}</DynList>
            </div>
            <div class="proejct-slider w-slide">
              <DynList items={projects.slice(1, 2)} class="project-collection-wrapper" itemsClass="project-collection-list" itemClass="project-collection-item-v1">{(project: any) => <ProjectSlideCard project={project} />}</DynList>
            </div>
            <div class="proejct-slider w-slide">
              <DynList items={projects.slice(2, 3)} class="project-collection-wrapper" itemsClass="project-collection-list" itemClass="project-collection-item-v1">{(project: any) => <ProjectSlideCard project={project} />}</DynList>
            </div>
          </div>
          <div class="project-slider-button left w-slider-arrow-left"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="slider-arrow">
              <path d="M10.3385 17.9011C10.3385 17.9011 5.04862 13.3787 5.04858 11.9969C5.04861 10.6151 10.3386 6.09284 10.3386 6.09284M5.63604 11.9969L19.7782 11.9969" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg></div>
          <div class="project-slider-button w-slider-arrow-right"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="slider-arrow">
              <path d="M13.6615 6.09504C13.6615 6.09504 18.9514 10.6174 18.9514 11.9992C18.9514 13.381 13.6614 17.9033 13.6614 17.9033M18.364 11.9992L4.22183 11.9992" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg></div>
          <div class="hide w-slider-nav w-round w-num"></div>
        </div>
      </section>
