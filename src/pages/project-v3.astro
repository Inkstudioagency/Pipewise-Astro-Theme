---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cta from '@/components/shared/Cta.astro';
import ProjectList from '@/components/sections/project-v3/ProjectList.astro';

const WF_PAGE = '6ab65229e15925776bc5bef5';
---

<BaseLayout wfPage={WF_PAGE} title="Project V3 - Pipewise" description="A wide case-study row layout for the Pipewise Astro theme, covering repairs, emergency call-outs, installations and commercial drain upgrades.">
  <Header variant="v2" id="nav-top" />
  <div class="main">
    <ProjectList />
    <Cta />
  </div>
  <Footer wfPage={WF_PAGE} backToTop="#nav-top" />
</BaseLayout>
