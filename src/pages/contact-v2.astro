---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cta from '@/components/shared/Cta.astro';
import Hero from '@/components/sections/contact-v2/Hero.astro';
import RequestForm from '@/components/sections/contact-v2/RequestForm.astro';
import Location from '@/components/sections/contact-v2/Location.astro';
import FaqHelp from '@/components/sections/shared/FaqHelp.astro';

const WF_PAGE = '6ab67786db0b6420857ab08b';
---

<BaseLayout wfPage={WF_PAGE} title="Contact V2 - Pipewise" description="The second contact layout in the Pipewise Astro theme, pairing the request form with an interactive service-area map and hover location pills.">
  <Header variant="v2" id="nav-top" />
  <Hero />
  <div class="main">
    <RequestForm />
    <Location />
    <FaqHelp />
    <Cta />
  </div>
  <Footer wfPage={WF_PAGE} backToTop="#nav-top" />
</BaseLayout>
