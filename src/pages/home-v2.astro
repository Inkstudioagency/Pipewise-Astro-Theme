---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cta from '@/components/shared/Cta.astro';
import Hero from '@/components/sections/home-v2/Hero.astro';
import About from '@/components/sections/home-v2/About.astro';
import Services from '@/components/sections/home-v2/Services.astro';
import WhyChooseUs from '@/components/sections/home-v2/WhyChooseUs.astro';
import HowItWorks from '@/components/sections/home-v2/HowItWorks.astro';
import Projects from '@/components/sections/home-v2/Projects.astro';
import Membership from '@/components/sections/home-v2/Membership.astro';
import ServiceArea from '@/components/sections/home-v2/ServiceArea.astro';
import Testimonials from '@/components/sections/home-v2/Testimonials.astro';
import Blog from '@/components/sections/home-v2/Blog.astro';
import FaqHelp from '@/components/sections/shared/FaqHelp.astro';

const WF_PAGE = '6ab4b675b9f31bbef19ece13';
---

<BaseLayout wfPage={WF_PAGE} title="Pipewise - Plumbing Astro Theme" description="The second homepage layout in the Pipewise Astro theme, leading with services, membership plans and a tabbed look at how every job gets handled.">
  <Header variant="v2" id="nav-top" />
  <div class="main">
    <Hero />
    <About />
    <Services />
    <WhyChooseUs />
    <HowItWorks />
    <Projects />
    <Membership />
    <ServiceArea />
    <Testimonials />
    <Blog />
    <FaqHelp />
    <Cta />
  </div>
  <Footer wfPage={WF_PAGE} backToTop="#nav-top" />
</BaseLayout>
