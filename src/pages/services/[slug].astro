---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cta from '@/components/shared/Cta.astro';
import Hero from '@/components/sections/service-detail/Hero.astro';
import PromiseSection from '@/components/sections/service-detail/Promise.astro';
import Overview from '@/components/sections/service-detail/Overview.astro';
import Coverage from '@/components/sections/service-detail/Coverage.astro';
import Testimonials from '@/components/sections/service-detail/Testimonials.astro';
import Related from '@/components/sections/service-detail/Related.astro';
import Faq from '@/components/sections/shared/Faq.astro';
import config from '@/config/config.json';
import { getServices } from '@/lib/content';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const WF_PAGE = '6ab52d2535713b17e2533cfd';
---

<BaseLayout
  wfPage={WF_PAGE}
  title={service.seo.metaTitle ?? `${service.name} - ${config.site.title}`}
  description={service.seo.metaDescription ?? service.shortDescription}
  image={service.mainImage.url}
>
  <div class="inner-hero-area">
    <Header id="navbar" />
    <Hero service={service} />
  </div>
  <div class="main">
    <PromiseSection service={service} />
    <Overview service={service} />
    <Coverage service={service} />
    <Testimonials />
    <Related slug={service.slug} />
    <Faq />
    <Cta />
  </div>
  <Footer wfPage={WF_PAGE} backToTop="#navbar" />
</BaseLayout>
