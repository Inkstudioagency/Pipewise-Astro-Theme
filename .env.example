# Strapi backend (see ./strapi). Used at build time only, never sent to the browser.
# Leave it unset to build with the demo content bundled in strapi/data/seed.json.
STRAPI_URL=http://localhost:1337

# Optional: a read-only Strapi API token (Settings > API Tokens > Read-only).
# Leave empty when the Public role is allowed to read the content (the seed script sets this up).
STRAPI_TOKEN=

# Optional: "remote" keeps Strapi media URLs in the built pages instead of downloading
# the files into dist/cms/ (use it when Strapi serves media from a CDN).
STRAPI_MEDIA=

# Optional: endpoint that receives form submissions (Formspree, Basin, Getform, your own API...).
# Leave empty to run the forms in demo mode (success message only, nothing is sent).
PUBLIC_FORM_ENDPOINT=
